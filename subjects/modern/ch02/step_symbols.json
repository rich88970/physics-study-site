      "keys": [
        "phi",
        "nu0",
        "KEmax",
        "V0"
      ]
    },
    {
      "title": "X 射線與繞射（第 5–6 節）",
      "keys": [
        "V",
        "lmin",
        "d",
        "thB",
        "n"
      ]
    },
    {
      "title": "康普頓效應（第 7 節）",
      "keys": [
        "lamC",
        "phiC",
        "thE",
        "lp",
        "m",
        "pe"
      ]
    },
    {
      "title": "吸收與重力（第 9–10 節）",
      "keys": [
        "mu",
        "I",
        "x12",
        "MR",
        "Rs"
      ]
    }
  ],
  "steps": {}
}
