{
  "_說明": "symbols 是本章符號總表；groups 決定總表分組；步驟用 data-sym 指定要提醒的符號（每頁只提醒第一次）。",
  "symbols": {
    "lam":  { "tex": "\\lambda,\\ \\lambda_0", "zh": "波長（介質中）／真空中的波長", "unit": "m", "note": "$\\lambda=\\lambda_0/n=v/\\nu$；考卷給的「介質中的波長」就是 $\\lambda$" },
    "k":    { "tex": "k=2\\pi/\\lambda,\\ \\vec k", "zh": "傳播常數（波數）、波向量", "unit": "m⁻¹", "note": "$\\vec k=k\\hat k$ 指向波前進的方向；$k=n\\omega/c_0$" },
    "nu":   { "tex": "\\nu\\ (f),\\ T=1/\\nu", "zh": "頻率、週期", "unit": "Hz、s", "note": "講義用 $\\nu$，考卷用 $f$；頻率進入介質不變" },
    "w":    { "tex": "\\omega=2\\pi\\nu", "zh": "角頻率", "unit": "rad/s", "note": "指數裡寫 $\\omega t$；考卷常要「π 不必展開」：$\\omega=2\\pi\\times10^{14}$" },
    "v":    { "tex": "v=c_0/n=\\nu\\lambda=\\omega/k", "zh": "相位速度（波速）", "unit": "m/s", "note": "定相位法：令相位為常數，$dx/dt$ 就是波速" },
    "n":    { "tex": "n", "zh": "折射率", "unit": "—", "note": "$\\mu_r=1$ 時 $n=\\sqrt{\\epsilon_r}$" },
    "c":    { "tex": "c_0\\ (c)", "zh": "真空中的光速", "unit": "m/s", "note": "$c_0=1/\\sqrt{\\epsilon_0\\mu_0}\\approx3\\times10^8$；考卷有時用 $c$ 代表介質中的 $c_0/n$，要看清楚" },
    "eps":  { "tex": "\\epsilon_0", "zh": "真空電容率", "unit": "C²s²/(kg·m³)", "note": "$8.8542\\times10^{-12}$；2018 年的卷給 $\\frac{1}{36\\pi}\\times10^{-9}$" },
    "E0":   { "tex": "E_0,\\ \\hat e", "zh": "電場振幅、電場（偏振）方向的單位向量", "unit": "V/m、—", "note": "$\\hat e\\perp\\hat k$" },
    "B0":   { "tex": "B_0,\\ \\hat b", "zh": "磁場振幅、磁場方向的單位向量", "unit": "T、—", "note": "$B_0=E_0/v=nE_0/c_0$；$\\hat b=\\hat k\\times\\hat e$" },
    "phi":  { "tex": "\\varphi=\\vec k\\cdot\\vec r-\\omega t+\\varphi_0", "zh": "相位（初始相位 $\\varphi_0$）", "unit": "rad", "note": "考卷常給「初始相位角為 0」" },
    "u":    { "tex": "u,\\ u_E,\\ u_B", "zh": "電磁能量密度（電場、磁場部分）", "unit": "J/m³", "note": "$u_E=u_B$，$u=\\epsilon_0E^2=B^2/\\mu_0$" },
    "S":    { "tex": "\\vec S=\\epsilon_0c^2\\vec E\\times\\vec B", "zh": "坡印廷向量（瞬時能流密度）", "unit": "W/m²", "note": "方向就是 $\\hat k$；介質中 $\\epsilon c^2=\\epsilon_0c_0^2$" },
    "Ee":   { "tex": "E_e=\\langle\\|\\vec S\\|\\rangle\\ (I)", "zh": "照度（輻射照度、時間平均的能流密度）", "unit": "W/m²", "note": "$\\tfrac12n\\epsilon_0c_0E_0^2$；不要和電場 $E$ 搞混" },
    "Phi":  { "tex": "\\Phi_e", "zh": "輻射通量（光功率）", "unit": "W", "note": "點光源 $E_e=\\Phi_e/4\\pi r^2$；光束 $E_e=\\Phi_e/A$" },
    "A":    { "tex": "A/r,\\ A/\\sqrt\\rho", "zh": "球面波、圓柱波的振幅", "unit": "V/m", "note": "$A$ 是離波源（或軸）單位距離處的振幅" },
    "beta": { "tex": "v/c,\\ \\lambda'", "zh": "都卜勒：相對速度（接近為正）、觀測到的波長", "unit": "—、m", "note": "$\\lambda'/\\lambda=\\sqrt{(1-v/c)/(1+v/c)}\\approx1-v/c$" }
  },
  "groups": [
    { "title": "波的基本量", "keys": ["lam", "k", "nu", "w", "v", "phi", "n", "c"] },
    { "title": "電磁場與能量", "keys": ["eps", "E0", "B0", "u", "S", "Ee", "Phi", "A"] },
    { "title": "都卜勒效應", "keys": ["beta"] }
  ],
