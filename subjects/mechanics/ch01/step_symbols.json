{
  "_說明": "symbols 是本章符號總表；groups 決定總表分組；steps 指定每個步驟（data-step）要提醒的符號。只列該步真正用到、容易混淆的符號，不要每步全列。",
  "symbols": {
    "x":        { "tex": "x", "zh": "自變數（常是位置）", "en": "variable / position", "unit": "依題目" },
    "dx":       { "tex": "\\mathrm dx", "zh": "x 的微小改變量", "en": "differential", "unit": "同 x", "note": "$\\mathrm df=f'(x)\\,\\mathrm dx$" },
    "n":        { "tex": "n", "zh": "次方", "unit": "無", "note": "$\\int x^n\\mathrm dx$ 公式需 $n\\neq-1$" },
    "fg":       { "tex": "f,\\ g", "zh": "兩個函數", "unit": "依題目" },
    "C":        { "tex": "C", "zh": "積分常數", "en": "integration constant", "unit": "同積分結果", "note": "由初始條件決定" },
    "u":        { "tex": "u,\\ y", "zh": "換元後的新變數", "unit": "依定義", "note": "例：$y\\equiv kx+b$、$u\\equiv1+x^2$" },
    "kb":       { "tex": "k,\\ b", "zh": "常數（一次式 $kx+b$）", "unit": "依題目", "note": "$k\\neq0$" },
    "t":        { "tex": "t", "zh": "時間", "unit": "s" },
    "xdot":     { "tex": "\\dot x", "zh": "對時間的一次導數（速度）", "en": "velocity", "unit": "m/s", "note": "$\\dot x=\\mathrm dx/\\mathrm dt$" },
    "xddot":    { "tex": "\\ddot x", "zh": "對時間的二次導數（加速度）", "en": "acceleration", "unit": "m/s²" },
    "gacc":     { "tex": "g", "zh": "重力加速度", "unit": "m/s²", "note": "取 $9.8$；只在自由落體例題使用" },
    "v0x0":     { "tex": "v_0,\\ x_0", "zh": "初速、初位置", "unit": "m/s、m" },

    "Avec":     { "tex": "\\vec A,\\ \\vec B,\\ \\vec C", "zh": "向量", "en": "vector", "unit": "依物理量", "note": "課本用粗體 $\\mathbf A$" },
    "Amag":     { "tex": "|\\vec A|=A", "zh": "向量的大小（長度）", "en": "magnitude", "unit": "同向量", "note": "非負；是純量" },
    "Ai":       { "tex": "A_1,A_2,A_3", "zh": "直角分量", "en": "components", "unit": "同向量", "note": "可正可負；隨座標改變" },
    "ijk":      { "tex": "\\hat i,\\hat j,\\hat k", "zh": "直角座標單位向量", "en": "unit vectors", "unit": "無", "note": "也寫 $\\hat x_1,\\hat x_2,\\hat x_3$ 或 $\\hat e_1,\\hat e_2,\\hat e_3$" },
    "Ahat":     { "tex": "\\hat A=\\vec A/|\\vec A|", "zh": "與 $\\vec A$ 同向的單位向量", "unit": "無" },
    "polar":    { "tex": "(r,\\theta)", "zh": "二維極座標：長度、與 $+x$ 軸夾角", "unit": "同向量、rad 或度", "note": "求角度要看象限" },
    "cs":       { "tex": "c", "zh": "乘在向量前的純量", "unit": "依題目", "note": "$|c\\vec A|=|c||\\vec A|$" },
    "r12":      { "tex": "\\vec r_1,\\ \\vec r_2,\\ \\Delta\\vec r", "zh": "前後位置與位移", "unit": "m", "note": "$\\Delta\\vec r=\\vec r_2-\\vec r_1$" },

    "theta":    { "tex": "\\theta", "zh": "夾角／旋轉角", "unit": "度或 rad", "note": "內積、外積中為兩向量夾角 $0^\\circ$–$180^\\circ$；第九節為座標軸轉角" },
    "dot":      { "tex": "\\vec A\\cdot\\vec B", "zh": "內積（純量）", "en": "dot product", "unit": "兩單位相乘", "note": "$=\\sum A_iB_i=AB\\cos\\theta$" },
    "AB":       { "tex": "A_B", "zh": "$\\vec A$ 沿 $\\vec B$ 方向的分量", "unit": "同 $\\vec A$", "note": "$=\\vec A\\cdot\\vec B/|\\vec B|$，除以「沿誰」的長度" },
    "cross":    { "tex": "\\vec A\\times\\vec B", "zh": "外積（向量）", "en": "cross product", "unit": "兩單位相乘", "note": "大小 $AB\\sin\\theta$；$\\vec B\\times\\vec A=-\\vec A\\times\\vec B$" },
    "Chat":     { "tex": "\\hat C", "zh": "外積方向（右手定則）", "unit": "無" },
    "di":       { "tex": "\\vec d_1,\\dots,\\vec d_4", "zh": "立方體體對角線", "unit": "無（邊長 1）" },
    "nvec":     { "tex": "\\vec n,\\ \\hat n", "zh": "平面法向量／其單位向量", "en": "normal", "unit": "—" },
    "X":        { "tex": "\\vec X", "zh": "待求的未知向量（1-13）", "unit": "—" },
    "phis":     { "tex": "\\phi", "zh": "純量（函數）；注意 $\\phi$ 也用來表示柱／球座標的方位角、1-3 的旋轉角，看上下文", "unit": "依題目", "note": "1-13 中為已知純量；p.35 中為純量函數" },
    "PQ":       { "tex": "P,\\ Q", "zh": "定點、動點", "unit": "—", "note": "$\\overrightarrow{PQ}=\\vec r-\\vec A$" },

    "omega":    { "tex": "\\omega=\\dot\\theta", "zh": "角速度（大小）", "en": "angular velocity", "unit": "rad/s" },
    "omegavec": { "tex": "\\vec\\omega", "zh": "角速度向量，沿轉軸", "unit": "rad/s", "note": "右手定則決定方向" },
    "R":        { "tex": "R", "zh": "到轉軸的垂直距離", "unit": "m", "note": "$R=r\\sin\\alpha$" },
    "alpha":    { "tex": "\\alpha", "zh": "$\\vec r$ 與轉軸的夾角", "unit": "度或 rad" },
    "rvec":     { "tex": "\\vec r", "zh": "位置向量", "en": "position", "unit": "m" },
    "vvec":     { "tex": "\\vec v=\\dot{\\vec r}", "zh": "速度", "unit": "m/s", "note": "$v=|\\vec v|$ 為速率" },
    "avec":     { "tex": "\\vec a=\\ddot{\\vec r}", "zh": "加速度", "unit": "m/s²" },
    "s":        { "tex": "s", "zh": "一般參數（常為時間）", "unit": "依定義" },
    "rmag":     { "tex": "r=|\\vec r|", "zh": "位置向量的長度", "unit": "m" },
    "rdot":     { "tex": "\\dot r", "zh": "1-32：$|\\dot{\\vec r}|$（速率）；1-33：$\\mathrm dr/\\mathrm dt$", "unit": "m/s", "note": "兩題意義不同！" },
    "bw":       { "tex": "b,\\ \\omega", "zh": "1-10 的長度常數與角頻率", "unit": "m、rad/s" },

    "Xmat":     { "tex": "x_{ij}", "zh": "矩陣第 $i$ 個 row、第 $j$ 個 column 的元素", "unit": "—", "note": "尺寸寫成 row 數 × column 數" },
    "Aik":      { "tex": "(AB)_{ij}=\\sum_k A_{ik}B_{kj}", "zh": "矩陣乘法：row 內積 column", "unit": "—", "note": "$(X\\times Y)(Y\\times Z)=X\\times Z$" },
    "T":        { "tex": "A^{\\mathsf T}", "zh": "轉置（課本寫 $A^t$）", "unit": "—", "note": "$(A^{\\mathsf T})_{ij}=A_{ji}$" },
    "inv":      { "tex": "A^{-1},\\ I", "zh": "反矩陣、單位矩陣", "unit": "—", "note": "$AA^{-1}=I$" },
    "det":      { "tex": "|A|,\\ \\det A", "zh": "行列式", "unit": "—", "note": "$|AB|=|A||B|$" },

    "P":        { "tex": "\\vec P", "zh": "被描述的固定點的位置向量", "unit": "—" },
    "xprime":   { "tex": "(x',y',z')", "zh": "同一點在新座標系的分量", "unit": "同原座標" },
    "xhatp":    { "tex": "\\hat x',\\ \\hat y'", "zh": "新座標軸的單位向量", "unit": "無" },
    "lambda":   { "tex": "\\lambda,\\ \\lambda_{ij}", "zh": "旋轉（變換）矩陣、方向餘弦", "unit": "無", "note": "$\\lambda_{ij}=\\hat x_i'\\cdot\\hat x_j$；row = 新軸在舊座標的分量" },
    "nhat":     { "tex": "\\hat n", "zh": "轉軸方向的單位向量（1-3）", "unit": "無" },
    "phir":     { "tex": "\\phi", "zh": "繞 $\\hat n$ 的旋轉角（1-3）", "unit": "度" },
    "dircos":   { "tex": "\\cos\\alpha,\\ \\cos\\beta,\\ \\cos\\gamma", "zh": "方向餘弦：直線與 $x_1,x_2,x_3$ 軸夾角的 cos", "unit": "—" },
    "tri":      { "tex": "\\theta_O,\\ \\theta_P,\\ \\theta_Q", "zh": "三角形 $OPQ$ 三個頂點的內角（1-18）", "unit": "度" },
    "ehat":     { "tex": "\\hat e", "zh": "固定方向的單位向量（1-24）", "unit": "—" },
    "sumidx":   { "tex": "\\sum_j,\\ \\sum_{j,k}", "zh": "對下標求和；被加總的下標是啞指標，可以換字母", "unit": "—" },
    "delta":    { "tex": "\\delta_{jk}", "zh": "Kronecker delta：$j=k$ 時為 1，否則為 0", "unit": "—" },
    "lam12":    { "tex": "\\lambda_1,\\ \\lambda_2", "zh": "連續兩次旋轉；先做 $\\lambda_1$ 時合成為 $\\lambda_2\\lambda_1$", "unit": "—" },
    "polu":     { "tex": "\\hat r,\\ \\hat\\theta", "zh": "極座標的單位向量（會隨粒子轉）", "unit": "—" },
    "cylu":     { "tex": "\\hat r,\\ \\hat\\phi,\\ \\hat z", "zh": "柱座標的單位向量；$r$ 是到 $z$ 軸的距離", "unit": "—" },
    "sphu":     { "tex": "\\hat r,\\ \\hat\\theta,\\ \\hat\\phi", "zh": "球座標的單位向量；$\\theta$ 從 $+z$ 軸量起", "unit": "—" },
    "Imom":     { "tex": "I", "zh": "轉動慣量：$\\int(\\text{到轉軸距離})^2\\,\\mathrm dm$", "unit": "kg·m²" },
    "rhoden":   { "tex": "\\rho,\\ M", "zh": "密度（面密度或體密度）、總質量", "unit": "kg/m² 或 kg/m³、kg" },
    "grad":     { "tex": "\\nabla\\phi", "zh": "梯度：指向 $\\phi$ 增加最快的方向", "unit": "依 $\\phi$" },
    "fvec":     { "tex": "\\vec f,\\ \\vec F,\\ \\vec V", "zh": "向量場（每一點都有一個向量）", "unit": "依題目" },
    "flux":     { "tex": "\\nabla\\cdot\\vec f", "zh": "散度：每單位體積的淨流出量（純量）", "unit": "依題目" },
    "dlam":     { "tex": "\\mathrm d\\vec\\lambda", "zh": "沿邊界曲線的一小段（Stokes 定理）", "unit": "m" },
    "dsig":     { "tex": "\\mathrm d\\vec\\sigma,\\ \\mathrm d\\vec a", "zh": "面積元：大小是面積，方向是法向量", "unit": "m²" },
    "eps":      { "tex": "\\varepsilon_{ijk}", "zh": "排列符號：偶排列 $+1$、奇排列 $-1$、有重複 $0$", "unit": "—" },
    "nabla":    { "tex": "\\nabla,\\ \\partial_x", "zh": "∇ 運算子；$\\partial_x=\\partial/\\partial x$ 是對 $x$ 偏微分（其他變數當常數）", "unit": "1/m" },
    "curl":     { "tex": "\\nabla\\times\\vec F", "zh": "旋度：局部扭轉，大小是小水車角速度的兩倍", "unit": "依題目" },
    "lap":      { "tex": "\\nabla^2", "zh": "拉普拉斯算子 $\\nabla\\cdot\\nabla=\\partial_x^2+\\partial_y^2+\\partial_z^2$", "unit": "1/m²" },
    "oint":     { "tex": "\\oint", "zh": "沿封閉曲線（或封閉曲面）的積分", "unit": "—" },
    "work":     { "tex": "W_{12},\\ U", "zh": "從點 1 到點 2 的功、位能（$W_{12}=U_1-U_2$）", "unit": "J" },
    "mu":       { "tex": "\\mu", "zh": "另一個正交矩陣（課本 §1.7 證明乘積正交時用）", "unit": "—" }
  },
  "groups": [
    {"title": "微積分（第一節）", "keys": ["x", "dx", "n", "fg", "C", "u", "kb", "t", "xdot", "xddot", "gacc", "v0x0"]},
    {"title": "向量基本（第二、三節）", "keys": ["Avec", "Amag", "Ai", "ijk", "Ahat", "polar", "cs", "r12"]},
    {"title": "內積與外積（第四、五節）", "keys": ["theta", "dot", "AB", "cross", "Chat", "nvec", "phis", "dircos", "tri", "ehat", "di", "X", "PQ", "eps"]},
    {"title": "運動學（第六、七節）", "keys": ["omega", "omegavec", "R", "alpha", "rvec", "vvec", "avec", "s", "rmag", "rdot", "bw"]},
    {"title": "矩陣與旋轉（第八、九節）", "keys": ["Xmat", "Aik", "T", "inv", "det", "P", "xprime", "xhatp", "lambda", "sumidx", "delta", "lam12", "nhat", "phir", "mu"]},
    {"title": "曲線座標與向量微積分（第十–十五節）", "keys": ["polu", "cylu", "sphu", "Imom", "rhoden", "grad", "fvec", "flux", "dlam", "dsig", "nabla", "curl", "lap", "oint", "work"]}
  ],
  "steps": {
    "c-reverse": ["dx", "n"],
    "c-ff1": ["xddot", "xdot", "C"],
    "c-ff2": ["xdot", "C", "v0x0"],
    "c-ln": ["dx"],
    "c-prod": ["fg", "dx"],
    "c-quot": ["fg"],
    "c-lin": ["kb", "dx"],
    "c-sub": ["u", "C"],
    "c-sub2": ["u"],

    "sv-polar": ["polar", "Ai"],
    "sv-len": ["Amag", "Ahat"],
    "va-sub": ["r12"],
    "va-scale": ["cs", "Amag"],
    "va-comp": ["Ai", "ijk"],

    "dot-geo": ["dot", "theta"],
    "dot-comp": ["AB", "Ahat"],
    "dot-calc": ["dot"],
    "dot-angle": ["theta", "Amag"],
    "ex15a": ["Avec", "Amag"],
    "ex15b": ["dot", "theta"],
    "ex15c": ["AB"],
    "tm17a": ["di"],
    "tm17b": ["di", "dot"],
    "tm17c": ["theta"],
    "tm117a": ["Avec", "theta"],
    "tm117b": ["Amag"],
    "tm117c": ["dot"],
    "tm18a": ["Avec", "rvec"],
    "tm18b": ["PQ"],
    "tm18d": ["Ahat", "AB"],

    "cr-mag": ["cross", "theta"],
    "cr-dir": ["Chat"],
    "cr-basis": ["ijk"],
    "tm19b": ["AB"],
    "tm19c": ["theta"],
    "tm19d": ["cross", "Ai"],
    "tm111a": ["cross", "det"],
    "tm111c": ["nvec"],
    "tm112a": ["nvec"],
    "tm112c": ["nvec", "AB"],
    "tm113b": ["X", "phis"],

    "ang-arc": ["omega", "R"],
    "ang-dir": ["omegavec"],
    "ang-cross": ["omegavec", "rvec", "alpha", "R"],
    "ang-ex1": ["omegavec", "vvec"],
    "ang-ex2": ["alpha", "R"],

    "dv-comp": ["s"],
    "dv-rules": ["phis", "s"],
    "dv-cross": ["cross"],
    "tm110a": ["bw"],
    "tm110b": ["vvec", "bw"],
    "tm110c": ["avec"],
    "tm110d": ["vvec"],
    "tm132a": ["rmag", "rdot"],
    "tm133a": ["rmag", "rdot"],
    "tm127a": ["rvec", "vvec", "avec"],

    "mx-dim": ["Xmat"],
    "mx-rule": ["Aik"],
    "tm114b": ["det"],
    "tm114e": ["T"],
    "tm14a": ["T"],
    "tm14b": ["inv"],

    "rot-idea": ["P", "xprime"],
    "rot-dot": ["xhatp"],
    "rot-angles": ["theta", "xhatp"],
    "rot-special": ["theta", "xprime"],
    "ex11a": ["lambda"],
    "ex11b": ["xprime"],
    "tm11a": ["xhatp"],
    "tm11b": ["lambda"],
    "tm11c": ["det"],
    "tm15a": ["det"],
    "tm115a": ["lambda"],
    "tm13a": ["nhat"],
    "tm13b": ["nhat", "phir"],
    "tm13c": ["lambda"],
    "tm13d": ["phir"]
  }
}
